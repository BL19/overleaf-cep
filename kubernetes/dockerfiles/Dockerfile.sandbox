# Overleaf Sandbox Image
# This extends TexLive images with a lightweight Node.js agent for pod reuse
#
# Build with different TexLive base images:
#   docker build -f kubernetes/dockerfiles/Dockerfile.sandbox \
#     --build-arg TEXLIVE_IMAGE=texlive/texlive:latest \
#     -t overleaf/sandbox:latest .

ARG TEXLIVE_IMAGE=texlive/texlive:latest
FROM ${TEXLIVE_IMAGE}

# Install Node.js (minimal installation for the agent)
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    ca-certificates \
    && curl -fsSL https://deb.nodesource.com/setup_20.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user for running the agent
RUN useradd -m -s /bin/bash -u 1000 texlive || true

# Create compile directory
RUN mkdir -p /compile && chown 1000:1000 /compile

# Create agent directory and copy agent code
WORKDIR /agent
COPY services/sandbox-agent/package.json /agent/
COPY services/sandbox-agent/agent.js /agent/

# Set ownership
RUN chown -R 1000:1000 /agent

# Switch to non-root user
USER 1000

# Environment variables
ENV COMPILE_DIR=/compile
ENV SANDBOX_AGENT_PORT=8080
ENV NODE_ENV=production

# Expose agent port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

# Start the agent
CMD ["node", "/agent/agent.js"]
